rules_version = '2';

// PHÂN QUYỀN FIRESTORE — Đại Phúc Khang
//
// Mặc định TỪ CHỐI mọi thứ. Collection nào chưa khai ở đây thì app không đọc
// không ghi được. Thêm màn mới = thêm luật cho collection của màn đó.

service cloud.firestore {
  match /databases/{database}/documents {

    function daDangNhap() {
      return request.auth != null;
    }

    function hoSo() {
      return get(/databases/$(database)/documents/NguoiDung/$(request.auth.uid)).data;
    }

    function coHoSo() {
      return daDangNhap() && exists(/databases/$(database)/documents/NguoiDung/$(request.auth.uid));
    }

    // Tài khoản ngưng = mất vai trò. Hồ sơ không có TrangThai = đang dùng.
    function vaiTro() {
      return coHoSo() && hoSo().get('TrangThai', 'Active') != 'Inactive' ? hoSo().VaiTro : '';
    }

    function laAdmin() {
      return vaiTro() == 'Admin';
    }

    function laNhanVien() {
      return vaiTro() in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe'];
    }

    // Hồ sơ người dùng: tự đọc hồ sơ mình; Admin đọc tất cả.
    // Người dùng KHÔNG tự sửa được hồ sơ mình — nếu được thì tự nâng mình lên Admin.
    //
    // TẠO / NGƯNG / XOÁ chỉ qua Cloud Functions (taoNhanVien,
    // doiTrangThaiNhanVien): phải đi cùng tài khoản đăng nhập, ghi tay ở app
    // thì hồ sơ và tài khoản lệch nhau. Functions dùng Admin SDK, bỏ qua luật.
    //
    // Admin chỉ sửa được tên, vai trò, số điện thoại; và KHÔNG đổi được vai
    // trò của chính mình (lỡ tay là mất quyền Admin, không ai cứu được).
    match /NguoiDung/{uid} {
      allow read: if (daDangNhap() && request.auth.uid == uid) || laAdmin();
      allow create, delete: if false;
      allow update: if laAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['HoTen', 'VaiTro', 'SoDienThoai'])
        && request.resource.data.HoTen is string && request.resource.data.HoTen.size() > 0
        && request.resource.data.VaiTro in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe']
        && (uid != request.auth.uid || request.resource.data.VaiTro == resource.data.VaiTro);
    }

    // ── DANH MỤC ────────────────────────────────────────────────────────
    // Mọi nhân viên đọc. KHÔNG ai xoá: chứng từ cũ còn trỏ tới — ngưng thay
    // vì xoá (TrangThai = 'Inactive').
    function trangThaiHopLe() {
      return request.resource.data.get('TrangThai', 'Active') in ['Active', 'Inactive'];
    }
    function chuoiCo(truong, toiDa) {
      return request.resource.data[truong] is string
        && request.resource.data[truong].size() > 0
        && request.resource.data[truong].size() <= toiDa;
    }
    function soHoacNull(truong) {
      return request.resource.data.get(truong, null) == null
        || (request.resource.data[truong] is number && request.resource.data[truong] >= 0);
    }

    // Xe, Sản phẩm (có giá): chỉ Admin.
    match /Xe/{id} {
      allow read: if laNhanVien();
      allow create, update: if laAdmin() && trangThaiHopLe() && chuoiCo('BienSo', 20) && soHoacNull('TaiTrong');
      allow delete: if false;
    }
    match /SanPham/{id} {
      allow read: if laNhanVien();
      allow create, update: if laAdmin() && trangThaiHopLe() && chuoiCo('Ten', 100)
        && request.resource.data.GiaBan is number && request.resource.data.GiaBan >= 0
        && request.resource.data.CoVo is bool && soHoacNull('GiaCocVo');
      allow delete: if false;
    }

    // Khách hàng: Admin, Sales, Điều phối thêm/sửa — họ là người gặp khách mới.
    match /KhachHang/{id} {
      allow read: if laNhanVien();
      allow create, update: if vaiTro() in ['Admin', 'Sales', 'DieuPhoi']
        && trangThaiHopLe() && chuoiCo('Ten', 120) && chuoiCo('DiaChi', 300);
      allow delete: if false;
    }

    // ── ĐƠN HÀNG ────────────────────────────────────────────────────────
    // Sales nhận đơn; Admin, Điều phối cũng tạo/sửa được. Chỉ sửa / huỷ khi
    // đơn còn "Moi" (chưa gán xe). Gán xe (ChuyenId, DaGan) để dành cho màn
    // Điều phối — chưa mở ở đây. Không ai xoá: huỷ kèm lý do.
    function nguoiNhanDon() {
      return vaiTro() in ['Admin', 'Sales', 'DieuPhoi'];
    }
    function donHopLe(d) {
      return d.KhachHangId is string && d.KhachHangId.size() > 0
        && d.TenKhach is string && d.DiaChi is string
        && d.NgayGiao is string && d.NgayGiao.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.Dong is list && d.Dong.size() > 0 && d.Dong.size() <= 30
        && d.ChuyenId == null;
    }
    match /DonHang/{id} {
      allow read: if laNhanVien();
      allow create: if nguoiNhanDon()
        && donHopLe(request.resource.data)
        && request.resource.data.TrangThai == 'Moi'
        && request.resource.data.TaoBoi == request.auth.uid;
      allow update: if nguoiNhanDon()
        && resource.data.TrangThai == 'Moi'
        && request.resource.data.TrangThai in ['Moi', 'Huy']
        && request.resource.data.TaoBoi == resource.data.TaoBoi
        && donHopLe(request.resource.data)
        && (request.resource.data.TrangThai == 'Moi'
            || (request.resource.data.LyDoHuy is string && request.resource.data.LyDoHuy.size() > 0));
      allow delete: if false;
    }
  }
}
