rules_version = '2';

// PHÂN QUYỀN FIRESTORE — Đại Phúc Khang
//
// Mặc định TỪ CHỐI mọi thứ. Collection nào chưa khai ở đây thì app không đọc
// không ghi được. Thêm màn mới = thêm luật cho collection của màn đó.

service cloud.firestore {
  match /databases/{database}/documents {

    function daDangNhap() {
      return request.auth != null;
    }

    function hoSo() {
      return get(/databases/$(database)/documents/NguoiDung/$(request.auth.uid)).data;
    }

    function coHoSo() {
      return daDangNhap() && exists(/databases/$(database)/documents/NguoiDung/$(request.auth.uid));
    }

    // Tài khoản ngưng = mất vai trò. Hồ sơ không có TrangThai = đang dùng.
    function vaiTro() {
      return coHoSo() && hoSo().get('TrangThai', 'Active') != 'Inactive' ? hoSo().VaiTro : '';
    }

    function laAdmin() {
      return vaiTro() == 'Admin';
    }

    function laNhanVien() {
      return vaiTro() in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe'];
    }

    // Hồ sơ người dùng: tự đọc hồ sơ mình; Admin đọc tất cả.
    // Người dùng KHÔNG tự sửa được hồ sơ mình — nếu được thì tự nâng mình lên Admin.
    //
    // TẠO / NGƯNG / XOÁ chỉ qua Cloud Functions (taoNhanVien,
    // doiTrangThaiNhanVien): phải đi cùng tài khoản đăng nhập, ghi tay ở app
    // thì hồ sơ và tài khoản lệch nhau. Functions dùng Admin SDK, bỏ qua luật.
    //
    // Admin chỉ sửa được tên, vai trò, số điện thoại; và KHÔNG đổi được vai
    // trò của chính mình (lỡ tay là mất quyền Admin, không ai cứu được).
    match /NguoiDung/{uid} {
      // Điều phối đọc được để chọn tài xế / phụ xe cho chuyến.
      allow read: if (daDangNhap() && request.auth.uid == uid) || vaiTro() in ['Admin', 'DieuPhoi'];
      allow create, delete: if false;
      allow update: if laAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['HoTen', 'VaiTro', 'SoDienThoai'])
        && request.resource.data.HoTen is string && request.resource.data.HoTen.size() > 0
        && request.resource.data.VaiTro in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe']
        && (uid != request.auth.uid || request.resource.data.VaiTro == resource.data.VaiTro);
    }

    // ── DANH MỤC ────────────────────────────────────────────────────────
    // Mọi nhân viên đọc. KHÔNG ai xoá: chứng từ cũ còn trỏ tới — ngưng thay
    // vì xoá (TrangThai = 'Inactive').
    function trangThaiHopLe() {
      return request.resource.data.get('TrangThai', 'Active') in ['Active', 'Inactive'];
    }
    function chuoiCo(truong, toiDa) {
      return request.resource.data[truong] is string
        && request.resource.data[truong].size() > 0
        && request.resource.data[truong].size() <= toiDa;
    }
    function soHoacNull(truong) {
      return request.resource.data.get(truong, null) == null
        || (request.resource.data[truong] is number && request.resource.data[truong] >= 0);
    }

    // Xe, Sản phẩm (có giá): chỉ Admin.
    match /Xe/{id} {
      allow read: if laNhanVien();
      allow create, update: if laAdmin() && trangThaiHopLe() && chuoiCo('BienSo', 20) && soHoacNull('TaiTrong');
      allow delete: if false;
    }
    match /SanPham/{id} {
      allow read: if laNhanVien();
      allow create, update: if laAdmin() && trangThaiHopLe() && chuoiCo('Ten', 100)
        && request.resource.data.GiaBan is number && request.resource.data.GiaBan >= 0
        && request.resource.data.CoVo is bool && soHoacNull('GiaCocVo');
      allow delete: if false;
    }

    // Khách hàng: Admin, Sales, Điều phối thêm/sửa — họ là người gặp khách mới.
    match /KhachHang/{id} {
      allow read: if laNhanVien();
      allow create, update: if vaiTro() in ['Admin', 'Sales', 'DieuPhoi']
        && trangThaiHopLe() && chuoiCo('Ten', 120) && chuoiCo('DiaChi', 300);
      allow delete: if false;
    }

    // ── ĐƠN HÀNG ────────────────────────────────────────────────────────
    // Sales nhận đơn; Admin, Điều phối cũng tạo/sửa được. Chỉ sửa / huỷ khi
    // đơn còn "Moi" (chưa gán xe). Gán xe (ChuyenId, DaGan) để dành cho màn
    // Điều phối — chưa mở ở đây. Không ai xoá: huỷ kèm lý do.
    function nguoiNhanDon() {
      return vaiTro() in ['Admin', 'Sales', 'DieuPhoi'];
    }
    function donHopLe(d) {
      return d.KhachHangId is string && d.KhachHangId.size() > 0
        && d.TenKhach is string && d.DiaChi is string
        && d.NgayGiao is string && d.NgayGiao.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.Dong is list && d.Dong.size() > 0 && d.Dong.size() <= 30
        && d.ChuyenId == null;
    }
    match /DonHang/{id} {
      allow read: if laNhanVien();
      allow create: if nguoiNhanDon()
        && donHopLe(request.resource.data)
        && request.resource.data.TrangThai == 'Moi'
        && request.resource.data.TaoBoi == request.auth.uid;
      allow update: if (nguoiNhanDon()
        && resource.data.TrangThai == 'Moi'
        && request.resource.data.TrangThai in ['Moi', 'Huy']
        && request.resource.data.TaoBoi == resource.data.TaoBoi
        && donHopLe(request.resource.data)
        && (request.resource.data.TrangThai == 'Moi'
            || (request.resource.data.LyDoHuy is string && request.resource.data.LyDoHuy.size() > 0)))
        || ganHoacBoDon(id)
        || ghiDaGiao(id);
      allow delete: if false;
    }

    // ── ĐIỀU PHỐI ───────────────────────────────────────────────────────
    function laDieuPhoi() {
      return vaiTro() in ['Admin', 'DieuPhoi'];
    }
    // Gán đơn vào chuyến / bỏ ra: chỉ đụng ChuyenId, TrangThai, XeGan; chuyến
    // phải còn "LapKeHoach" và danh sách đơn của chuyến (SAU lần ghi này) phải
    // khớp — app ghi đơn và chuyến trong cùng một transaction.
    function ganHoacBoDon(id) {
      let moi = request.resource.data;
      let cu = resource.data;
      return laDieuPhoi()
        && moi.diff(cu).affectedKeys().hasOnly(['ChuyenId', 'TrangThai', 'XeGan', 'SuaLuc', 'SuaBoi'])
        && (
          (cu.TrangThai == 'Moi' && cu.ChuyenId == null
            && moi.TrangThai == 'DaGan' && moi.ChuyenId is string
            && getAfter(/databases/$(database)/documents/Chuyen/$(moi.ChuyenId)).data.TrangThai == 'LapKeHoach'
            && id in getAfter(/databases/$(database)/documents/Chuyen/$(moi.ChuyenId)).data.DonIds)
          || (cu.TrangThai == 'DaGan' && cu.ChuyenId is string
            && moi.TrangThai == 'Moi' && moi.ChuyenId == null
            && getAfter(/databases/$(database)/documents/Chuyen/$(cu.ChuyenId)).data.TrangThai == 'LapKeHoach'
            && !(id in getAfter(/databases/$(database)/documents/Chuyen/$(cu.ChuyenId)).data.DonIds))
        );
    }
    function chuyenHopLe(c) {
      return c.Ngay is string && c.Ngay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && c.XeId is string && c.BienSo is string
        && c.SoChuyen is int && c.SoChuyen > 0
        && c.TaiXe.uid is string && c.TaiXe.HoTen is string
        && c.PhuXe is list && c.PhuXe.size() <= 3
        && c.DonIds is list && c.DonIds.size() <= 100;
    }
    match /Chuyen/{id} {
      allow read: if laNhanVien();
      allow create: if laDieuPhoi()
        && chuyenHopLe(request.resource.data)
        && request.resource.data.TrangThai == 'LapKeHoach'
        && request.resource.data.DonIds.size() == 0
        && request.resource.data.TaoBoi == request.auth.uid;
      // Chỉ sửa khi còn "LapKeHoach". Không đổi ngày, xe, số chuyến, người
      // tạo. Huỷ chỉ khi không còn đơn nào. Xuất kho (bước sau) do máy chủ ghi.
      allow update: if (laDieuPhoi()
        && resource.data.TrangThai == 'LapKeHoach'
        && chuyenHopLe(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['TaiXe', 'PhuXe', 'ToXeUids', 'GhiChu', 'DonIds', 'TrangThai', 'SuaLuc', 'SuaBoi'])
        && (request.resource.data.TrangThai == 'LapKeHoach'
            || (request.resource.data.TrangThai == 'Huy' && request.resource.data.DonIds.size() == 0)))
        // Tài xế / phụ xe báo "Xong giao, về kho".
        || (trongToXe(resource.data)
            && resource.data.TrangThai == 'DangGiao' && request.resource.data.TrangThai == 'VeKho'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['TrangThai', 'VeKhoLuc', 'VeKhoBoi'])
            && request.resource.data.VeKhoBoi == request.auth.uid)
        // Kế toán xác nhận đã nhận tiền mặt.
        || (vaiTro() in ['Admin', 'KeToan']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['NopTien'])
            && resource.data.NopTien.TrangThai == 'ChoNop'
            && request.resource.data.NopTien.TrangThai == 'DaNop'
            && request.resource.data.NopTien.PhaiNop == resource.data.NopTien.PhaiNop
            && request.resource.data.NopTien.SoNhan is int && request.resource.data.NopTien.SoNhan >= 0
            && request.resource.data.NopTien.ChenhLech == request.resource.data.NopTien.SoNhan - resource.data.NopTien.PhaiNop
            && request.resource.data.NopTien.Boi == request.auth.uid);
      allow delete: if false;
    }

    // ── KHO ─────────────────────────────────────────────────────────────
    // Tồn kho, nợ vỏ NCC, phiếu nhập, điều chỉnh tồn: CHỈ máy chủ ghi
    // (functions: nhapHang, datTonKho). App chỉ đọc.
    match /NhaCungCap/{id} {
      allow read: if laNhanVien();
      allow create, update: if laAdmin() && trangThaiHopLe() && chuoiCo('Ten', 120);
      allow delete: if false;
    }
    match /TonKho/{id} {
      allow read: if laNhanVien();
      allow write: if false;
    }
    match /NoVoNCC/{id} {
      allow read: if vaiTro() in ['Admin', 'ThuKho', 'KeToan'];
      allow write: if false;
    }
    match /PhieuNhap/{id} {
      allow read: if vaiTro() in ['Admin', 'ThuKho', 'KeToan'];
      allow write: if false;
    }
    match /DieuChinhTon/{id} {
      allow read: if vaiTro() in ['Admin', 'KeToan'];
      allow write: if false;
    }

    // ── XUẤT KHO ────────────────────────────────────────────────────────
    // Máy chủ ghi (xuatKho, huyXuatKho, nhanHang). Tài xế/phụ xe đọc được
    // phiếu xuất và hàng trên xe.
    match /PhieuXuat/{id} {
      allow read: if laNhanVien();
      allow write: if false;
    }
    match /PhieuXuatHuy/{id} {
      allow read: if vaiTro() in ['Admin', 'ThuKho', 'KeToan'];
      allow write: if false;
    }
    match /TrenXe/{id} {
      allow read: if laNhanVien();
      allow write: if false;
    }

    // ── GIAO HÀNG ───────────────────────────────────────────────────────
    // Tài xế / phụ xe ghi phiếu giao TRÊN ĐIỆN THOẠI, kể cả khi mất sóng
    // (Firestore lưu tạm, có mạng thì gửi — luật được kiểm lúc gửi).
    // PhieuGiao là SỔ GỐC, KHÔNG SỬA, KHÔNG XOÁ. Chỉ kế toán/Admin ghi được
    // trường CK (xác nhận chuyển khoản). Công nợ, hàng trên xe: máy chủ cộng
    // dồn ở bước kết thúc chuyến.
    function chuyenCua(cid) {
      return get(/databases/$(database)/documents/Chuyen/$(cid)).data;
    }
    function trongToXe(c) {
      return request.auth.uid in c.get('ToXeUids', []);
    }
    function soTien(n) {
      return n is int && n >= 0;
    }
    match /PhieuGiao/{id} {
      allow read: if laNhanVien();
      allow create: if laNhanVien()
        && request.resource.data.ChuyenId is string
        && trongToXe(chuyenCua(request.resource.data.ChuyenId))
        && chuyenCua(request.resource.data.ChuyenId).TrangThai == 'DangGiao'
        && request.resource.data.TaoBoi == request.auth.uid
        && request.resource.data.Ngay == chuyenCua(request.resource.data.ChuyenId).Ngay
        && request.resource.data.XeId == chuyenCua(request.resource.data.ChuyenId).XeId
        && request.resource.data.Dong is list && request.resource.data.Dong.size() > 0 && request.resource.data.Dong.size() <= 30
        && request.resource.data.Vo is list
        && soTien(request.resource.data.TT.TienMat) && soTien(request.resource.data.TT.ChuyenKhoan) && soTien(request.resource.data.TT.GhiNo)
        && soTien(request.resource.data.PhaiThu)
        && request.resource.data.TT.TienMat + request.resource.data.TT.ChuyenKhoan + request.resource.data.TT.GhiNo == request.resource.data.PhaiThu
        && ((request.resource.data.TT.ChuyenKhoan == 0 && request.resource.data.CK == null)
            || (request.resource.data.TT.ChuyenKhoan > 0 && request.resource.data.CK.TrangThai == 'ChoXacNhan'))
        && ((request.resource.data.TaiCho == false && request.resource.data.DonId == id
              && get(/databases/$(database)/documents/DonHang/$(id)).data.ChuyenId == request.resource.data.ChuyenId)
            || (request.resource.data.TaiCho == true && request.resource.data.DonId == null));
      allow update: if vaiTro() in ['Admin', 'KeToan']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['CK'])
        && resource.data.CK.TrangThai == 'ChoXacNhan'
        && request.resource.data.CK.TrangThai in ['DaXacNhan', 'KhongThay']
        && request.resource.data.CK.Boi == request.auth.uid;
      allow delete: if false;
    }
    // Đơn có trong chuyến → "Đã giao" / "Không giao được", CÙNG LÚC với phiếu
    // giao (một batch): phiếu phải có thật sau lần ghi này.
    function ghiDaGiao(id) {
      let moi = request.resource.data;
      return resource.data.TrangThai == 'DaGan'
        && moi.TrangThai in ['DaGiao', 'KhongGiao']
        && moi.diff(resource.data).affectedKeys().hasOnly(['TrangThai', 'PhieuGiaoId', 'SuaLuc', 'SuaBoi'])
        && moi.PhieuGiaoId == id
        && existsAfter(/databases/$(database)/documents/PhieuGiao/$(id))
        && trongToXe(chuyenCua(resource.data.ChuyenId));
    }

    // Tài khoản nhận chuyển khoản (để dựng mã QR). Không phải bí mật — in
    // trên QR khách nào cũng thấy. Chỉ Admin sửa.
    match /CaiDat/{id} {
      allow read: if laNhanVien();
      allow write: if laAdmin();
    }

    // ── KẾT THÚC CHUYẾN ─────────────────────────────────────────────────
    // Máy chủ ghi (ketThucChuyen). Công nợ: Sales xem được để nhắc khách.
    match /DoiSoatChuyen/{id} {
      allow read: if vaiTro() in ['Admin', 'ThuKho', 'KeToan', 'DieuPhoi'];
      allow write: if false;
    }
    match /CongNoKhach/{id} {
      allow read: if vaiTro() in ['Admin', 'KeToan', 'Sales'];
      allow write: if false;
    }
  }
}
