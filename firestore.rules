rules_version = '2';

// PHÂN QUYỀN FIRESTORE — Đại Phúc Khang
//
// Mặc định TỪ CHỐI mọi thứ. Collection nào chưa khai ở đây thì app không đọc
// không ghi được. Thêm màn mới = thêm luật cho collection của màn đó.

service cloud.firestore {
  match /databases/{database}/documents {

    function daDangNhap() {
      return request.auth != null;
    }

    function hoSo() {
      return get(/databases/$(database)/documents/NguoiDung/$(request.auth.uid)).data;
    }

    function coHoSo() {
      return daDangNhap() && exists(/databases/$(database)/documents/NguoiDung/$(request.auth.uid));
    }

    // Tài khoản ngưng = mất vai trò. Hồ sơ không có TrangThai = đang dùng.
    function vaiTro() {
      return coHoSo() && hoSo().get('TrangThai', 'Active') != 'Inactive' ? hoSo().VaiTro : '';
    }

    function laAdmin() {
      return vaiTro() == 'Admin';
    }

    function laNhanVien() {
      return vaiTro() in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe'];
    }

    // Hồ sơ người dùng: tự đọc hồ sơ mình; Admin đọc tất cả.
    // Người dùng KHÔNG tự sửa được hồ sơ mình — nếu được thì tự nâng mình lên Admin.
    //
    // TẠO / NGƯNG / XOÁ chỉ qua Cloud Functions (taoNhanVien,
    // doiTrangThaiNhanVien): phải đi cùng tài khoản đăng nhập, ghi tay ở app
    // thì hồ sơ và tài khoản lệch nhau. Functions dùng Admin SDK, bỏ qua luật.
    //
    // Admin chỉ sửa được tên, vai trò, số điện thoại; và KHÔNG đổi được vai
    // trò của chính mình (lỡ tay là mất quyền Admin, không ai cứu được).
    match /NguoiDung/{uid} {
      allow read: if (daDangNhap() && request.auth.uid == uid) || laAdmin();
      allow create, delete: if false;
      allow update: if laAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['HoTen', 'VaiTro', 'SoDienThoai'])
        && request.resource.data.HoTen is string && request.resource.data.HoTen.size() > 0
        && request.resource.data.VaiTro in ['Admin', 'DieuPhoi', 'Sales', 'KeToan', 'ThuKho', 'TaiXe', 'PhuXe']
        && (uid != request.auth.uid || request.resource.data.VaiTro == resource.data.VaiTro);
    }

    // Danh mục: mọi nhân viên đọc; chỉ Admin sửa.
    match /SanPham/{id} {
      allow read: if laNhanVien();
      allow write: if laAdmin();
    }
    match /KhachHang/{id} {
      allow read: if laNhanVien();
      allow write: if laAdmin();
    }
    match /Xe/{id} {
      allow read: if laNhanVien();
      allow write: if laAdmin();
    }
  }
}
